{
  "name": "@formulavize/compiler-frontend-fiz",
  "version": "0.1.0",
  "description": "Compiler frontend for the fiz language",
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:format": "prettier . --check",
    "format": "prettier . --write",
    "all": "run-s build test"
  },
  "dependencies": {
    "ts-pattern": "^5.9.2"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@formulavize/lang-fiz": "^2.3.1",
    "@lezer/common": "^1.5.5"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@formulavize/lang-fiz": "^2.3.1",
    "@lezer/common": "^1.5.5",
    "npm-run-all": "^4.1.5",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthologen/compiler-frontend-fiz.git"
  },
  "author": "anthologen",
  "license": "MIT"
}
